# compiled binaries
obelisk
obelisk.exe
obelisk-*
# legacy pre-rename binary names — keep ignoring them through the transition so a
# stale Mnemosyne-era build lying around never gets committed.
mnemosyne
mnemosyne.exe
mnemosyne-*
*.zip
# ...but the embedded escrow source placeholder MUST be tracked (go:embed needs it;
# release builds overwrite it with the real tagged source before compiling).
!escrow/obelisk-src.tar.gz

# local data - NEVER commit catalogs or keystores
catalog.json
config.json
keystore*.json
.mnemo/

# editor cruft
.vscode/*.log
.DS_Store

# Claude Code local session/config dir — never commit
.claude/
